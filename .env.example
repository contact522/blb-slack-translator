# 이 파일을 .env 로 복사해 값을 채운다. .env 는 Git 에 올리지 않는다.

# Slack 앱 > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Slack 앱 > Basic Information > App-Level Tokens (scope: connections:write 하나)
SLACK_APP_TOKEN=xapp-...
# YWH 워크스페이스. 봇 토큰의 워크스페이스와 다르면 시작하지 않는다.
SLACK_TEAM_ID=T0AGU4JEHUL

# 유료 번역 API. false 면 모달에 미리보기 안내만 보이고 외부 번역 호출을 하지 않는다.
PAID_API_ENABLED=false
OPENAI_API_KEY=
# 2026-09-29 비교: gpt-6-luna 가 gpt-5.6-luna 보다 자연스럽고 싸다(번역 1건 약 0.06원).
OPENAI_MODEL=gpt-6-luna

# 호출 제한(프로세스 메모리 기준, 재시작하면 초기화). 월 예산 상한이 아니다.
RATE_LIMIT_PER_USER_PER_MINUTE=10
RATE_LIMIT_PER_DAY=500

# 이 반응을 달면 번역 (이모지 이름). 사람별 기본 언어 저장 폴더.
TRANSLATE_REACTION=globe_with_meridians
DATA_DIR=data

# 상태 확인 주소. 기본은 이 PC 에서만 접근 가능.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000
